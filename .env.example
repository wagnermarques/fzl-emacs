# Exemplo de variáveis de ambiente para conexões SQL no Emacs (sql-connections.el)
# Copie este arquivo para .env e preencha com as credenciais reais:
#   cp .env.example .env

# Conexão Local (integra-local)
INTEGRA_LOCAL_DB_HOST=ip_do_servidor_local
INTEGRA_LOCAL_DB_PORT=porta_do_servidor_local
INTEGRA_LOCAL_DB_USER=root
INTEGRA_LOCAL_DB_PASS=suasenhalocal
INTEGRA_LOCAL_DB_NAME=nomedobanco

# Conexão Dev (integra-dev)
INTEGRA_DEV_DB_HOST=ip_do_servidor_dev
INTEGRA_DEV_DB_PORT=porta_do_servidor_dev
INTEGRA_DEV_DB_USER=usuario_no_servidor_dev
INTEGRA_DEV_DB_PASS=suasenhadev
INTEGRA_DEV_DB_NAME=nome_do_banco_no_servidor_dev

# Conexão Dev (edutec homolog)
EDUTEC2_HOMOLOG_DB_HOST=ip_do_servidor_edutec
EDUTEC2_HOMOLOG_DB_PORT=porta_do_servidor_edutec
EDUTEC2_HOMOLOG_DB_USER=usuario_edutec
EDUTEC2_HOMOLOG_DB_PASS=suasenhaedutec
EDUTEC2_HOMOLOG_DB_NAME=edutec

# Conexão Dev (moodle homolog)
MOODLE_HOMOLOG_DB_HOST=ip_do_servidor_moodle
MOODLE_HOMOLOG_DB_PORT=porta_do_servidor_moodle
MOODLE_HOMOLOG_DB_USER=usuario_moodle
MOODLE_HOMOLOG_DB_PASS=suasenhamoodle
MOODLE_HOMOLOG_DB_NAME=moodle

# VPN Trabalho / UNESP (OpenVPN)
UNESP_VPN_DIR=/caminho/para/vpn
UNESP_VPN_OVPN_FILE=/caminho/para/vpn/unesp.ovpn
UNESP_VPN_USER=seu.usuario@unesp
UNESP_VPN_PASS="suasenhavpn"
